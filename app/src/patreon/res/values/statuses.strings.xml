    <string name="status_downloading">Downloading…</string>
    <string name="status_deleting">Deleting…</string>
    <string name="status_no_remote_backups">No backups online yet</string>
    <string name="status_couldnt_load_remote_backups">Couldn\'t load the online backups</string>
