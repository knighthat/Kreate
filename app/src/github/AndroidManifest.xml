<!-- Only in the github build, the one that updates itself from GitHub's releases -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Installs the downloaded update, see GitHubUpdater -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Android 12+: updates the app without asking once it installed itself -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application>
        <!-- The system's answers to an update's install session -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
