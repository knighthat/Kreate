<!-- Dialog titles and bodies. -->
<resources>
    <!-- %1$s is the host name or address of the user's own server. "Someone" is an unknown attacker, no gender. Self-signed certificate = a security certificate the server made itself -->
    <string name="dialog_title_trust_certificate">Faites-vous confiance à ce certificat ?</string>
    <!-- %1$s is the host name or address of the user's own server. Self-signed = a security certificate the server made itself, not checked by anyone else -->
    <string name="dialog_title_clear_the_queue">Vider la file d\'attente ?</string>
    <string name="dialog_body_clear_the_queue_1">Tous les morceaux, à l\'exception de celui qui est en cours de lecture, sont supprimés de la file d\'attente.</string>
    <string name="dialog_body_clear_the_queue_2">Supprimer le morceau en cours de lecture</string>
    <string name="dialog_body_clear_the_queue_3">Cela mettra fin à la lecture et fermera le lecteur en plein écran</string>
    <!-- %1$s is the name of the user's OpenSubsonic server as the server calls itself, e.g. Navidrome (proper noun, shown with a possessive 's); "you" is the user, gender unknown. Certificate = the server's security certificate -->
    <string name="dialog_body_reset_the_order">Les titres reprennent l\'ordre de l\'album.</string>
    <string name="dialog_title_unsaved_changes">Enregistrer les modifications ?</string>
    <string name="dialog_body_unsaved_changes">Vous avez modifié cette playlist, mais vous ne l\'avez pas encore enregistrée.</string>
    <string name="dialog_title_delete_playlist">Supprimer la playlist ?</string>
    <!-- %1$s is the playlist's quoted name -->
    <string name="dialog_title_restart_the_app">Redémarrer l\'application ?</string>
    <string name="dialog_body_restart_the_app">La lecture s\'arrête et l\'application se relance ; les réglages nécessitant un redémarrage sont alors pris en compte.</string>
    <string name="dialog_title_restart_the_player">Redémarrer le lecteur ?</string>
    <!-- Two audio quality names, e.g. High or Low. %1$s is the quality of the copy already cached, %2$s is the quality a download would get. Each is followed by its own line, \n is a line break -->
    <!-- %1$s is the title of a song in quotes (the user's own text, not declined), or "this song" when unknown. A downloaded copy is deleted from the device -->
    <!-- %1$s is the title of a song in quotes (the user's own text, not declined), or "this song" when unknown. A download in progress is cancelled -->
    <string name="dialog_title_clear_history">Effacer l\'historique ?</string>
    <string name="dialog_body_clear_history">Tous les morceaux écoutés par ce profil sont supprimés de son historique.</string>
    <!-- %1$s is the name of a music source, e.g. YouTube Music (proper noun, don't decline it). "Liked" = given a like (thumbs up); the account is the user's account on that source -->
    <!-- %1$s is the name of a music source, e.g. OpenSubsonic (proper noun, don't decline it). "Favorites" = the songs marked with a star on the server -->
    <!-- %1$s is the size currently stored, %2$s is the new, smaller limit, both file sizes with unit, e.g. 1.2 GB. Cache = temporary copies of songs kept for faster playback; "the app" restarts -->
    <!-- %1$s is the size currently stored, a file size with unit, e.g. 1.2 GB. Cache = temporary copies of songs kept for faster playback -->
    <!-- %1$s is the space the downloaded songs take, a file size with unit, e.g. 1.2 GB. "Take" = occupy, not remove -->
    <!-- %1$s is the space the downloaded songs take, %2$s is the new, smaller limit, both file sizes with unit, e.g. 1.2 GB. "Take" = occupy, not remove -->
    <string name="dialog_title_search_lyrics">Rechercher des paroles</string>
    <string name="dialog_title_find_recording">Retrouver l\'enregistrement</string>
    <string name="dialog_title_find_artist">Trouver l\'artiste</string>
    <string name="dialog_body_find_artist_no_matches">Aucun artiste trouvé</string>
    <!-- %1$s is the name of a music source, e.g. YouTube Music, or of the user's OpenSubsonic server as the server calls itself (proper noun, don't decline it). A question in a dialog title; "sign out" = log out of the account -->
    <!-- %1$s is the name of a music source, e.g. YouTube Music (proper noun, don't decline it). "Library" = the songs, playlists and artists the user saved. "Liked" = given a like (thumbs up) on the source -->
    <!-- %1$s is a counted plural, e.g. "3 songs". Songs of the user's library that were downloaded in the old version of this app -->
