    <string name="screen_search_hint_library">Search your library</string>
    <!-- %1$s is the name of a music source, e.g. YouTube Music (proper noun, don't decline it). Hint inside the search field; "Search" is a verb (imperative) -->
    <string name="screen_search_hint_youtube">Search %1$s</string>
    <!-- %1$s is the name of the user's OpenSubsonic server as the server calls itself, e.g. Navidrome, or OpenSubsonic until it answers (proper noun, don't decline it). Hint inside the search field; "Search" is a verb (imperative) -->
    <string name="screen_search_hint_opensubsonic">Search %1$s</string>
    <!-- %1$s is the name of this app, Kreate. An example of what to say to a voice assistant, e.g. "Play ... on Kreate"; "Play" is a verb (imperative), "..." stands for a song, album or artist name the user says -->
    <string name="screen_voice_search_hint_phrase">Play … on %1$s</string>
    <!-- %1$s is the example phrase from screen_voice_search_hint_phrase, in quotes, e.g. "Play ... on Kreate" (a voice command). "These" are the sources listed below the text. "A match" = a song, album or artist found -->
    <string name="screen_voice_search_hint_order">%1$s searches these from the top until one finds a match. Drag to change the order, switch one off to skip it.</string>
    <string name="screen_search_status_no_history">Your searches will show up here</string>
    <!-- %1$s is what the user typed, in quotes (the user's own text). Search suggestions -->
    <string name="screen_search_status_no_suggestions">No suggestions for %1$s</string>
    <!-- %1$s is what the user searched for, in quotes (the user's own text). Empty search results for songs -->
    <string name="screen_search_results_status_none_songs">No songs found for %1$s</string>
    <!-- %1$s is what the user searched for, in quotes (the user's own text). Empty search results for albums -->
    <string name="screen_search_results_status_none_albums">No albums found for %1$s</string>
    <!-- %1$s is what the user searched for, in quotes (the user's own text). Empty search results for artists -->
    <string name="screen_search_results_status_none_artists">No artists found for %1$s</string>
    <!-- %1$s is what the user searched for, in quotes (the user's own text). Empty search results for playlists -->
    <string name="screen_search_results_status_none_playlists">No playlists found for %1$s</string>
    <string name="screen_youtube_more_status_nothing_here">Nothing here</string>
    <!-- %1$s is a song title in quotes, or "this song" when the title isn't known. Lyrics = the words of the song -->
    <string name="screen_lyrics_status_missing">No lyrics for %1$s</string>
    <!-- %1$s is the name of a lyrics provider, e.g. LRCLIB (proper noun); %2$s is a song title in quotes, or "this song" when unknown. Lyrics = the words of the song -->
    <string name="screen_lyrics_status_unavailable">%1$s has no lyrics for %2$s.</string>
    <!-- %1$s is the name of the lyrics provider that supplied the lyrics (proper noun, don't decline it), shown as a credit -->
    <string name="screen_lyrics_status_from">From %1$s</string>
    <string name="screen_open_source_licenses_hint_search">Search libraries</string>
    <!-- %1$s is what the user typed in the search field, in quotes (the user's own text). "Library" is a software library, not a place with books -->
    <string name="screen_open_source_licenses_status_no_match">No library matches %1$s</string>
    <!-- %1$s is a small icon character standing for the Change source button, shown as it appears in the interface. "Press" = tap. Don't translate it -->
    <string name="screen_lyrics_hint_change_source">Press Change source (%1$s) below to pick another source.</string>
    <!-- %1$s is the name of a music database, MusicBrainz (proper noun); %2$s is a song title in quotes, or "this song" when unknown -->
    <string name="screen_song_details_status_not_found">%1$s has no match for %2$s.</string>
    <!-- %1$s is a small icon character (magnifying glass) standing for the Search button, shown as it appears in the interface. "Press" = tap. Don't translate it -->
    <string name="screen_song_details_hint_search">Press Search (%1$s) to search with other words.</string>
    <string name="screen_song_details_hint_not_kept">Not in your library, so this match isn\'t kept</string>
    <!-- %1$s is the name of a music database, MusicBrainz (proper noun); %2$s is an artist name in quotes, or "this artist" when unknown -->
    <string name="screen_artist_details_status_not_found">%1$s has no match for %2$s.</string>
    <!-- %1$s is a small icon character (magnifying glass) standing for the Search button, shown as it appears in the interface. "Press" = tap. Don't translate it -->
    <string name="screen_artist_details_hint_search">Press Search (%1$s) to search with another name.</string>
    <string name="screen_profiles_hint_search_or_add">Search or add profile</string>
    <!-- %1$s is a date, e.g. "3 November 2026", formatted by the device. Since when the profile (a separate set of settings and library) has been in use -->
    <string name="screen_profiles_status_active_since">Active since %1$s</string>
    <!-- %1$s is a relative time from the device, e.g. "2 days ago". When the profile was last used. "Seen" = in use, not about a person -->
    <string name="screen_profiles_status_last_seen">Last seen %1$s</string>
