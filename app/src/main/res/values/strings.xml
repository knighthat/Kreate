    <string name="wizard_dear_user">Dear User,</string>
    <string name="wizard_intro">A few quick steps and you are ready to listen. Here is what comes next:</string>
    <string name="wizard_permissions_entry">Control what %1$s can and cannot do or see.</string>
    <string name="wizard_import_entry">Bring over existing data from another machine or backup.</string>
    <string name="wizard_profile_entry">Taylor the app to your taste.</string>
    <string name="wizard_permissions_intro">%1$s needs your permission for the following. You can skip any of them and allow it later.</string>
    <string name="wizard_music">Music</string>
    <string name="wizard_music_description">Read the audio files stored on this device to build your library</string>
