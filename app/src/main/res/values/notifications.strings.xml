<!-- Notification channels, titles and subtitles. -->
<resources>
    <string name="notification_playback_title_channel">Playback problems</string>
    <string name="notification_playback_subtitle_channel">A song couldn\'t be played</string>
    <string name="notification_other_title_channel">Other</string>
    <string name="notification_other_subtitle_channel">One-off notices, like a backup that couldn\'t be restored, and music starting in the background</string>
    <string name="notification_local_scan_title_channel">Music on this device</string>
    <string name="notification_local_scan_subtitle_channel">Progress of reading the device\'s music and measuring its loudness</string>
    <string name="notification_sleep_timer_title_channel">Sleep timer</string>
    <string name="notification_sleep_timer_subtitle_channel">Time left until the music pauses, with buttons to change it</string>
    <string name="notification_local_scan_title_scanning">Scanning music</string>
    <string name="notification_local_scan_title_scanned">Music scan finished</string>
    <!-- %1$s is a counted plural, e.g. "12 songs". Found on the device by a scan for local music -->
    <string name="notification_local_scan_subtitle_scanned">%1$s scanned</string>
    <string name="notification_local_scan_title_measuring">Measuring loudness</string>
    <!-- %1$d is the number of songs processed so far, %2$d the total, both whole numbers, shown as a fraction, e.g. 3/10 -->
    <string name="notification_local_scan_subtitle_progress">%1$d/%2$d</string>
    <string name="notification_local_scan_title_measured">Loudness measured</string>
    <!-- %1$d is the number of songs whose loudness was measured, %2$d the total, both whole numbers. "Measured" = the loudness (volume level) of the song was analyzed -->
    <string name="notification_local_scan_subtitle_measured">%1$d/%2$d measured</string>
    <!-- Whole numbers. %1$d = songs measured, %2$d = total songs, %3$d = failures listed in the notification (shown as child notifications), %4$d = all failures. Measured = the loudness of the song was analyzed -->
    <string name="notification_local_scan_subtitle_failures_listed">%1$d/%2$d, %3$d of %4$d failures listed</string>
    <!-- %1$s is the internal id of a song (text/number, not translated), used as its name when the song has no title -->
    <string name="notification_local_scan_title_song">Song %1$s</string>
    <string name="notification_sleep_timer_title_running">Sleep timer</string>
    <string name="notification_sleep_timer_title_finished">Sleep timer finished</string>
    <string name="notification_sleep_timer_subtitle_on_hold">On hold</string>
    <string name="notification_sleep_timer_subtitle_until_song_ends">Until the song ends</string>
    <!-- %1$s is a clock time of the device, e.g. 22:30. The sleep timer paused the music at that time -->
    <string name="notification_sleep_timer_subtitle_paused_at">Music paused at %1$s</string>
    <string name="notification_other_title_resuming">Resuming music</string>
    <string name="notification_other_title_starting">Starting music</string>
    <string name="notification_downloads_title_channel">Downloads</string>
    <string name="notification_downloads_subtitle_channel">Songs being downloaded, downloaded, or that couldn\'t be downloaded</string>
    <string name="notification_downloads_title_downloading">Downloading</string>
    <string name="notification_downloads_title_downloaded">Downloaded</string>
    <string name="notification_downloads_title_failed">Download failed</string>
    <string name="notification_downloads_subtitle_paused">Paused</string>
    <string name="notification_playlist_import_title_channel">Playlist imports</string>
    <string name="notification_playlist_import_subtitle_channel">Progress of importing playlist files, and the songs that couldn\'t be imported</string>
    <!-- %1$s is the name of the playlist made from a playlist file (as the file or the user named it, not translated) -->
    <string name="notification_playlist_import_title_imported">%1$s imported successfully</string>
    <!-- %1$s is the name of the playlist made from a playlist file (as the file or the user named it, not translated). Some of its songs couldn't be imported, they are listed under it -->
    <string name="notification_playlist_import_title_imported_with_errors">%1$s imported with errors</string>
    <!-- %1$s is the name of a playlist of a playlist file (as the file or the user named it, not translated). None of its songs could be imported, so the playlist wasn't made -->
    <string name="notification_playlist_import_title_not_imported">%1$s couldn\'t be imported</string>
    <!-- %1$s is a counted plural of songs, e.g. "12 songs"; %2$s is the name of a music source, e.g. YouTube Music (proper noun, don't decline it). Every song of the imported playlist was found there -->
    <string name="notification_playlist_import_subtitle_all_found">All %1$s were found on %2$s</string>
    <!-- %1$s is a counted plural of songs, e.g. "12 songs". Every song of the playlist file went into the imported playlist -->
    <string name="notification_playlist_import_subtitle_all_imported">All %1$s were imported</string>
    <!-- %1$d is how many songs were imported (whole number), %2$s the counted plural of all the playlist's songs, e.g. "9 of 10 songs imported" -->
    <string name="notification_playlist_import_subtitle_some_imported">%1$d of %2$s imported</string>
    <!-- None of the songs of a playlist of a playlist file could be imported -->
    <string name="notification_playlist_import_subtitle_nothing">No songs imported</string>
    <!-- %1$s is the title of the notification, e.g. "Mix imported with errors"; %2$d is how many of the songs that couldn't be imported are listed as notifications under it, %3$d how many there are (whole numbers) -->
    <string name="notification_playlist_import_subtitle_failures_listed">%1$s, %2$d of %3$d failures listed</string>
</resources>
