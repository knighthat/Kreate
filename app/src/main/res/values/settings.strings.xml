    <string name="setting_description_configure_opensubsonic_status_certificate_untrusted">%1$s\'s certificate isn\'t trusted</string>
    <!-- %1$s is the name of the user's OpenSubsonic server as the server calls itself, e.g. Navidrome, or OpenSubsonic until it answers (proper noun, don't decline it). Certificate = the server's security certificate -->
    <string name="setting_description_configure_opensubsonic_status_certificate_changed">%1$s\'s certificate changed</string>
    <!-- %1$s is the name of a protocol, OpenSubsonic (proper noun). The address entered doesn't belong to a server that speaks it -->
    <string name="setting_description_configure_opensubsonic_status_not_opensubsonic">Not an %1$s server</string>
