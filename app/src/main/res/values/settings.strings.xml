    <string name="setting_description_server_status_unreachable">Can\'t reach %1$s: %2$s</string>
    <!-- %1$s is the name of the user's OpenSubsonic server as the server calls itself, e.g. Navidrome, or OpenSubsonic until it answers (proper noun, don't decline it). Certificate = the server's security certificate; "its own" = a self-signed certificate that the server made itself -->
    <string name="setting_description_server_status_certificate_untrusted">%1$s\'s certificate isn\'t trusted. If it uses its own, allow self-signed certificates</string>
