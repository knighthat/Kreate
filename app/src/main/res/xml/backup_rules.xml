<!--
   Backup rules for API 30 and below, keep in sync with data_extraction_rules.xml.
   See https://developer.android.com/guide/topics/data/autobackup

   Files that must stay on the device get an <exclude> here. Paths take no wildcards, so a file
   under a folder with a variable name (like profiles/<id>/) goes in noBackupFilesDir instead,
   which Android never backs up. Secrets (secrets.preferences_pb) live there.
-->
<full-backup-content>
    <!-- Index of the song caches (SongCaches), the songs are in folders never backed up -->
    <exclude
        domain="database"
        path="exoplayer_internal.db" />
    <exclude
        domain="database"
        path="exoplayer_internal.db-journal" />
    <!-- Cloud backups downloaded to restore (RemoteBackups, patreon only), in the app's folder of
         external storage, or the internal one without it; the cloud keeps them -->
    <exclude
        domain="external"
        path="cloud_backups" />
    <exclude
        domain="file"
        path="cloud_backups" />
    <!-- Crash logs, in the app's folder of external storage (CrashHandler) -->
    <exclude
        domain="external"
        path="crashlogs" />
    <!-- Texts delivered by the Crowdin SDK and when they were last checked (TranslationUpdates,
         patreon only), a new install fetches them again -->
    <exclude
        domain="sharedpref"
        path="com.crowdin.platform.string.preferences.xml" />
    <exclude
        domain="sharedpref"
        path="com.crowdin.platform.string.repository.xml" />
    <exclude
        domain="sharedpref"
        path="translation_checks.xml" />
</full-backup-content>
