<!--
   Backup and transfer rules for API 31 and above, keep in sync with backup_rules.xml.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   Files that must stay on the device get an <exclude> in both sections. Paths take no wildcards,
   so a file under a folder with a variable name (like profiles/<id>/) goes in noBackupFilesDir
   instead, which Android never backs up or transfers. Secrets (secrets.preferences_pb) live there.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Index of the song caches (SongCaches), the songs are in folders never backed up -->
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude
            domain="database"
            path="exoplayer_internal.db-journal" />
    </cloud-backup>
    <device-transfer>
        <!-- Index of the song caches (SongCaches), the songs are in folders never backed up -->
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <exclude
            domain="database"
            path="exoplayer_internal.db-journal" />
    </device-transfer>
</data-extraction-rules>
