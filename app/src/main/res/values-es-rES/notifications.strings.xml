<!-- Notification channels, titles and subtitles. -->
<resources>
    <string name="notification_playback_title_channel">Problemas de reproducción</string>
    <string name="notification_playback_subtitle_channel">No se pudo reproducir una canción</string>
    <string name="notification_other_title_channel">Otro</string>
    <string name="notification_other_subtitle_channel">Avisos de una sola vez, como una copia de seguridad que no pudo ser restaurada, y música comenzando en segundo plano</string>
    <string name="notification_local_scan_title_channel">Música en este dispositivo</string>
    <string name="notification_local_scan_subtitle_channel">Progreso en la lectura de la música en el dispositivo y la medición de su volumen</string>
    <string name="notification_sleep_timer_title_channel">Temporizador de apagado</string>
    <string name="notification_sleep_timer_subtitle_channel">Tiempo restante hasta que la música se pause, con botones para cambiarlo</string>
    <string name="notification_local_scan_title_scanning">Escaneando música</string>
    <string name="notification_local_scan_title_scanned">Escaneo de música finalizado</string>
    <!-- %1$s is a counted plural, e.g. "12 songs". Found on the device by a scan for local music -->
    <string name="notification_local_scan_subtitle_scanned">%1$s escaneadas</string>
    <string name="notification_local_scan_title_measuring">Midiendo volumen</string>
    <!-- %1$d is the number of songs processed so far, %2$d the total, both whole numbers, shown as a fraction, e.g. 3/10 -->
    <string name="notification_local_scan_subtitle_progress">%1$d/%2$d</string>
    <string name="notification_local_scan_title_measured">Volumen medido</string>
    <!-- %1$d is the number of songs whose loudness was measured, %2$d the total, both whole numbers. "Measured" = the loudness (volume level) of the song was analyzed -->
    <string name="notification_local_scan_subtitle_measured">%1$d/%2$d medidas</string>
    <!-- Whole numbers. %1$d = songs measured, %2$d = total songs, %3$d = failures listed in the notification (shown as child notifications), %4$d = all failures. Measured = the loudness of the song was analyzed -->
    <string name="notification_local_scan_subtitle_failures_listed">%1$d/%2$d, %3$d de %4$d fallos listados</string>
    <!-- %1$s is the internal id of a song (text/number, not translated), used as its name when the song has no title -->
    <string name="notification_local_scan_title_song">Canción %1$s</string>
    <string name="notification_sleep_timer_title_running">Temporizador de apagado</string>
    <string name="notification_sleep_timer_title_finished">El temporizador de apagado ha acabado</string>
    <string name="notification_sleep_timer_subtitle_on_hold">En espera</string>
    <string name="notification_sleep_timer_subtitle_until_song_ends">Hasta que acabe la canción</string>
    <!-- %1$s is a clock time of the device, e.g. 22:30. The sleep timer paused the music at that time -->
    <string name="notification_sleep_timer_subtitle_paused_at">Música pausada a las %1$s</string>
    <string name="notification_other_title_resuming">Reanudando música</string>
    <string name="notification_other_title_starting">Iniciando música</string>
    <string name="notification_downloads_title_channel">Descargas</string>
    <string name="notification_downloads_subtitle_channel">Canciones descargando, descargadas o que no pudieron ser descargadas</string>
    <string name="notification_downloads_title_downloading">Descargando</string>
    <string name="notification_downloads_title_downloaded">Descargado</string>
    <string name="notification_downloads_title_failed">Descarga fallida</string>
    <string name="notification_downloads_subtitle_paused">En pausa</string>
</resources>
