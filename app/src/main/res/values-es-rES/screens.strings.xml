    <string name="screen_liked_status_no_matches">No hay canciones con me gusta que coincidan con los filtros</string>
    <string name="screen_disliked_status_nothing_disliked">No hay canciones con no me gusta</string>
    <string name="screen_disliked_status_no_matches">No hay canciones con no me gusta que coincidan con los filtros</string>
    <string name="screen_downloaded_status_nothing_downloaded">No hay canciones descargadas</string>
    <string name="screen_downloaded_status_no_matches">No hay canciones descargadas que coincidan con los filtros</string>
    <string name="status_downloads_waiting_for_wifi">Esperando conexión Wi-Fi</string>
    <string name="status_downloads_waiting_for_battery">Esperando, la batería está baja</string>
    <!-- %1$s is the downloaded part of a file and %2$s the whole file, both file sizes, e.g. "1.2 MB of 4 MB" -->
    <string name="status_download_progress">%1$s de %2$s</string>
    <string name="status_download_next_in_line">Siguiente en espera</string>
    <string name="status_download_in_line_2">2ª en espera</string>
    <string name="status_download_in_line_3">3ª en espera</string>
    <string name="status_download_in_line_4">4ª en espera</string>
    <string name="status_download_in_line_5">5ª en espera</string>
    <!-- %1$s is a percentage, e.g. 40%. A download that was paused (stopped for a while) when it reached that point -->
    <string name="status_download_paused_at">Pausada al %1$s</string>
    <string name="screen_download_queue_status_nothing">No se está descargando nada</string>
    <string name="screen_statistics_status_nothing_played">Todavía no has reproducido nada</string>
    <string name="screen_statistics_status_nothing_this_month">No has reproducido nada este mes</string>
    <string name="screen_player_status_timer_on_hold_song_end">En espera, hasta que la canción termine</string>
    <string name="screen_player_status_timer_song_end">Se pausa al acabar la canción</string>
    <!-- %1$s is the time left, e.g. 4:32. The sleep timer is on hold (not counting down) because the music is paused; "left" = remaining -->
    <string name="screen_player_status_timer_on_hold">En espera, quedan %1$s</string>
    <!-- %1$s is the time left, e.g. 4:32. "Pauses" is a verb: the sleep timer will pause the music after that time -->
    <string name="screen_player_status_timer_running">Se pausa en %1$s</string>
    <string name="screen_crash_hint">Algo salió mal. Comparte el registro de abajo cuando lo reportes.</string>
    <string name="screen_crash_status_no_log">No se pudo leer el registro de errores.</string>
    <string name="screen_title_new_playlist">Nueva lista de reproducción</string>
    <string name="screen_title_old_app_downloads">Descargas antiguas</string>
    <!-- %1$d is how many songs were found so far, %2$d how many there are in all -->
    <string name="screen_old_app_downloads_status_loading">Cargando canciones… %1$d de %2$d</string>
    <!-- %1$s is the name of a music source, e.g. YouTube Music (proper noun, don't decline it) -->
    <string name="screen_old_app_downloads_status_failed">No se pudieron cargar las demás canciones de %1$s.</string>
    <string name="screen_old_app_downloads_status_nothing_found">Ya no se puede encontrar ninguna canción.</string>
