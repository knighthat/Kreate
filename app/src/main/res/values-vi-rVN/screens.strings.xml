    <!-- %1$s is the name of a music source, e.g. YouTube Music, or of the user's OpenSubsonic server as the server calls itself (proper noun, don't decline it). Hint inside the search field; "Search" is a verb (imperative) -->
    <string name="screen_search_hint_source">Tìm trên %1$s</string>
    <!-- %1$s is the name of this app, Kreate. An example of what to say to a voice assistant, e.g. "Play ... on Kreate"; "Play" is a verb (imperative), "..." stands for a song, album or artist name the user says -->
    <string name="screen_voice_search_hint_phrase">Phát … trên %1$s</string>
    <!-- %1$s is the example phrase from screen_voice_search_hint_phrase, in quotes, e.g. "Play ... on Kreate" (a voice command). "These" are the sources listed below the text. "A match" = a song, album or artist found -->
    <string name="screen_voice_search_hint_order">%1$s để tìm trong ứng dụng. Kéo/Thả để di chuyển thứ tự tìm, tắt để bỏ qua nguồn.</string>
    <string name="screen_search_status_no_history">Gợi ý sẽ được hiển thị ở đây</string>
    <!-- %1$s is what the user typed, in quotes (the user's own text). Search suggestions -->
    <string name="screen_search_status_no_suggestions">Không có gợi ý cho %1$s</string>
    <!-- %1$s is what the user searched for, in quotes (the user's own text). Empty search results for songs -->
