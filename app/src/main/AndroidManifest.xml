<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Reads the music on the device to build the local catalog -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps playing with the app in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_black"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_black_round"
        android:supportsRtl="true"
        android:name=".KreateApplication"
        android:theme="@style/Theme.Kreate">
        <activity
            android:name=".KreateActivity"
            android:exported="true"
            android:theme="@style/Theme.Kreate.Splash" />

        <!-- One launcher entry per app icon, only the chosen one is enabled (see AppIcon) -->
        <activity-alias
            android:name=".BlackIcon"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_black"
            android:roundIcon="@mipmap/ic_launcher_black_round"
            android:targetActivity=".KreateActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".GradientIcon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".KreateActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ProfilesActivity"
            android:exported="false" />

        <!-- Exported so media controllers, like the system's and Bluetooth devices, can connect -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>