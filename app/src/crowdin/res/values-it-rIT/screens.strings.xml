    <string name="screen_player_status_timer_on_hold">In attesa, %1$s rimanente</string>
    <!-- %1$s is the time left, e.g. 4:32. "Pauses" is a verb: the sleep timer will pause the music after that time -->
    <string name="screen_player_status_timer_running">Pausa fra %1$s</string>
