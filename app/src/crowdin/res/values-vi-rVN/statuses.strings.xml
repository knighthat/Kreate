<!-- Single-word statuses that are not tied to one setting (off, on, ...). -->
<resources>
    <string name="status_off">Tắt</string>
    <string name="status_system">Theo hệ thống</string>
    <string name="status_online">Online</string>
    <string name="status_checking">Đang kiểm tra…</string>
    <string name="status_signed_in">Đã đăng nhập</string>
    <string name="status_unlimited">Không giới hạn</string>
    <string name="status_not_set">Chưa đặt</string>
    <!-- Under a menu entry that is grayed out because its feature is switched off in settings -->
    <string name="status_disabled_in_settings">Tắt trong cài đặt</string>
    <string name="optional">Không bắt buộc</string>
    <!-- %1$s is a counted time period, e.g. "3 days" or "1 hour", from the plurals day, week, month and year. English word order: the period comes first, then "ago" -->
    <string name="status_ago">%1$s trước</string>
    <string name="status_granted">Đã cấp quyền</string>
    <string name="status_unknown_artist">Không rõ nghệ sĩ</string>
    <string name="status_unknown_file">Tệp không xác định</string>
    <string name="status_no_playlists_yet">Chưa có danh sách phát nào</string>
    <string name="status_no_playlists_to_add_to">Không có danh sách nào</string>
    <string name="status_couldnt_load_playlists">Không thể tải danh sách</string>
    <string name="status_playlist_empty">Không có nhạc</string>
    <string name="status_nothing_played">Chưa nghe gì</string>
    <!-- Under a playlist being imported: %1$s songs of %2$s have been searched for on YouTube Music so far, both numbers formatted, e.g. "Searching 120 of 1,722" -->
    <string name="status_import_searched">Đang tìm %1$s / %2$s</string>
    <!-- Under a playlist just made on a music source that the source doesn't list yet; %1$s is the name of the source, e.g. YouTube Music (proper noun, don't decline it) -->
    <string name="status_waiting_for_source">Đang chờ %1$s</string>
    <!-- %1$s is the name of the app's build, e.g. FOSS (free and open source software, the build made for F-Droid). Shown for a feature that build leaves out: under the Discord and song recognition rows of Network settings, and as a message when the Songs tab is held to recognize a song -->
    <string name="status_not_available_in">Không có trên bản %1$s</string>
    <string name="status_not_signed_in">Chưa đăng nhập</string>
    <!-- %1$s is the name of the user's server as the server calls itself, e.g. Navidrome, or OpenSubsonic until it answers (proper noun, don't decline it). Certificate = the server's security certificate -->
    <string name="status_certificate_untrusted">Chứng chỉ của %1$s chưa được tin</string>
    <!-- %1$s is the name of the user's server as the server calls itself, e.g. Navidrome, or OpenSubsonic until it answers (proper noun, don't decline it). Certificate = the server's security certificate -->
    <string name="status_certificate_changed">Chứng chỉ của %1$s đã thay đổi</string>
    <!-- %1$s is the name of a music source or the user's server, e.g. YouTube Music or Navidrome (proper noun, don't decline it). "Can't reach" = no network connection to it -->
    <string name="status_unreachable">%1$s không phản hồi</string>
    <!-- %1$s is the name of a music source, e.g. YouTube Music (proper noun, don't decline it); "you" is the user, gender unknown. The source ended the login session, so the user must sign in again -->
    <string name="status_signed_out">%1$s đã vô hiệu hóa phiên này</string>
    <!-- %1$s is the name of the user's server as the server calls itself, e.g. Navidrome, or OpenSubsonic until it answers (proper noun, don't decline it). The app is testing the connection; "Checking" is a present participle -->
    <string name="status_checking_server">Đang kiểm tra %1$s…</string>
    <string name="status_signing_in">Đang đăng nhập…</string>
    <string name="status_reading">Đang đọc…</string>
    <string name="status_saving">Đang lưu…</string>
    <string name="status_downloading">Đang tải…</string>
    <string name="status_deleting">Đang xóa…</string>
    <string name="status_backup_saved">Sao lưu thành công</string>
    <!-- A backup file of the app (profiles, settings and library) couldn't be opened or read -->
    <string name="status_couldnt_read_backup">Không thể đọc sao lưu</string>
    <!-- A backup file of the app (profiles, settings and library) couldn't be written -->
    <string name="status_couldnt_save_backup">Không thể tạo bản sao lưu</string>
    <!-- The sign in page of an online service (e.g. Discord, Patreon) is open in the browser and the app waits for it to finish -->
    <string name="status_waiting_for_sign_in_page">Đang chờ hoàn tất đăng nhập…</string>
    <!-- Value of a date row (e.g. a membership's renewal date) when no date is coming -->
    <string name="status_none_scheduled">Không xác định</string>
    <!-- An update of the app is being installed -->
</resources>
