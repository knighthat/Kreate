    "views": [
      {
        "viewName": "user_album_view",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT\n    ual.user_id AS user_id,\n    a.id AS album_id,\n    a.origin AS origin,\n    COALESCE(ual.name, a.name) AS name,\n    COALESCE(ual.artists, a.artists) AS artists,\n    COALESCE(ual.thumbnail, a.thumbnail) AS thumbnail,\n    a.year AS year,\n    a.url AS url,\n    a.is_explicit AS is_explicit,\n    (SELECT COUNT(*) FROM song s WHERE s.album_id = a.id) AS song_count,\n    ual.bookmarked_at AS bookmarked_at\nFROM user_album ual\nJOIN album a ON a.id = ual.album_id"
      },
      {
        "viewName": "user_artist_view",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT\n    uar.user_id AS user_id,\n    ar.id AS artist_id,\n    ar.origin AS origin,\n    COALESCE(uar.name, ar.name) AS name,\n    COALESCE(uar.thumbnail, ar.thumbnail) AS thumbnail,\n    (SELECT COUNT(*) FROM song_artist_map m WHERE m.artist_id = ar.id) AS song_count,\n    uar.follow_since AS follow_since\nFROM user_artist uar\nJOIN artist ar ON ar.id = uar.artist_id"
      },
      {
        "viewName": "user_song_view",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT\n    us.user_id AS user_id,\n    s.id AS song_id,\n    s.origin AS origin,\n    COALESCE(us.name, s.name) AS name,\n    COALESCE(\n        us.artists,\n        (SELECT json_group_array(COALESCE(ua.name, ar.name)) FILTER (WHERE COALESCE(ua.name, ar.name) IS NOT NULL)\n            FROM song_artist_map m\n            JOIN artist ar ON ar.id = m.artist_id\n            LEFT JOIN user_artist ua ON ua.artist_id = ar.id AND ua.user_id = us.user_id\n            WHERE m.song_id = s.id)\n    ) AS artists,\n    (SELECT json_group_array(m.artist_id) FROM song_artist_map m WHERE m.song_id = s.id) AS artist_ids,\n    COALESCE(us.thumbnail, s.thumbnail, ual.thumbnail, al.thumbnail) AS thumbnail,\n    s.duration AS duration,\n    s.is_explicit AS is_explicit,\n    s.album_id AS album_id,\n    COALESCE(ual.name, al.name) AS album_name,\n    COALESCE(us.album_position, s.album_position) AS album_position,\n    s.unavailable_since AS unavailable_since,\n    us.liked_at AS liked_at\nFROM user_song us\nJOIN song s ON s.id = us.song_id\nLEFT JOIN album al ON al.id = s.album_id\nLEFT JOIN user_album ual ON ual.album_id = s.album_id AND ual.user_id = us.user_id\nWHERE s.unavailable_since IS NULL"
      }
